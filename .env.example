# .env.example
# Copia este archivo a ".env" (sin .example) y ajusta los valores.

# ── XAMPP (local) ────────────────────────────────────────────
# DB_HOST=localhost
# DB_NAME=siae_imss
# DB_USER=root
# DB_PASS=            ← deja vacío si tu XAMPP no tiene contraseña
#                       o pon la contraseña que configuraste
# URL_BASE=/ProgWeb/siae-imss/

# ── Docker ───────────────────────────────────────────────────
# DB_HOST=db
# DB_NAME=siae_imss
# DB_USER=root
# DB_PASS=tu_password
# URL_BASE=/ProgWeb/siae-imss/

# ── Copia la sección que aplique y quita los # ───────────────

DB_HOST=localhost
DB_NAME=siae_imss
DB_USER=root
DB_PASS=
URL_BASE=/ProgWeb/siae-imss/
